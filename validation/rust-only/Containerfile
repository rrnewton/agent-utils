# Rust-only mode: the dispatched Rust tools with no Python interpreter.
#
#   podman build -t agent-utils-rust-only -f validation/rust-only/Containerfile .
#   podman run --rm agent-utils-rust-only
#
# In-image network needs (the build has not yet run anywhere; treat
# these as unverified until the first successful build):
#   * docker.io, to pull the rust and debian base images;
#   * crates.io (index and crate downloads), because the workspace
#     lockfile names ~156 registry crates and nothing is vendored
#     or built --offline;
#   * native build dependencies of transitive crates on the slim
#     image (a C toolchain, pkg-config) are assumed by the base
#     image, not demonstrated.
# The runtime stage deliberately has no cargo/rustc, no git, and no
# systemd: wrkslotsd doctor and herdr-run paths that shell out to
# git behave accordingly, and cpuset-alloc reports its systemd-scope
# BLOCKED there. Host run without a container, once release binaries
# exist (the smoke never builds):
#   BIN_DIR=rs/target/release SMOKE_FIXTURES=validation/rust-only/fixtures \
#     sh validation/rust-only/smoke.sh
#
# The runtime image is built from the workspace's release binaries and a
# POSIX shell only. The build stage needs the Rust toolchain; neither stage
# installs Python, and the smoke entrypoint fails if an interpreter is
# present on PATH. This is the hermetic version of
# scripts/check_rust_only.py (#542 rust-primary-rust-only-check), extended
# by #2131 rust-only-functional-check from --help probes to real flows.

FROM docker.io/library/rust:1-slim-bookworm AS build
WORKDIR /src
COPY rs ./rs
RUN cargo build --release --locked --workspace

FROM docker.io/library/debian:bookworm-slim
COPY --from=build /src/rs/target/release/agentctl /src/rs/target/release/herdr-agent /usr/local/bin/
COPY --from=build /src/rs/target/release/dagrun /src/rs/target/release/cpuset-alloc /usr/local/bin/
COPY --from=build /src/rs/target/release/tick-hub /src/rs/target/release/herdr-run /usr/local/bin/
COPY --from=build /src/rs/target/release/pr-landing-planner /usr/local/bin/
COPY --from=build /src/rs/target/release/wrkslotsd /src/rs/target/release/wrkvizd /usr/local/bin/
COPY --from=build /src/rs/target/release/agent-teams /src/rs/target/release/agent-usage /src/rs/target/release/gh-paced /usr/local/bin/
COPY validation/rust-only/fixtures /usr/local/share/agent-utils-rust-only/fixtures
COPY validation/rust-only/smoke.sh /usr/local/bin/agent-utils-rust-only-smoke
RUN chmod +x /usr/local/bin/agent-utils-rust-only-smoke
ENTRYPOINT ["/usr/local/bin/agent-utils-rust-only-smoke"]
