{
  "resource_caps": {"browser": 1},
  "steps": [
    {"group": "build", "job": "app", "desc": "compile the web app",
     "cmd": "echo '[build] compiling web app' && sleep 2"},
    {"group": "e2e", "job": "login", "desc": "browser login flow (needs the browser)",
     "cmd": "echo '[e2e] login flow' && sleep 3",
     "deps": ["build.app"], "hint": {"resources": {"browser": 1}}},
    {"group": "e2e", "job": "checkout", "desc": "browser checkout flow (needs the browser)",
     "cmd": "echo '[e2e] checkout flow' && sleep 3",
     "deps": ["build.app"], "hint": {"resources": {"browser": 1}}},
    {"group": "test", "job": "unit", "desc": "unit tests (no browser; free to run in parallel)",
     "cmd": "echo '[test] unit tests' && sleep 3",
     "deps": ["build.app"]}
  ]
}
