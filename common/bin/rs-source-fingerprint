#!/usr/bin/env bash
# TRACKED helper: print a deterministic fingerprint of the agent-utils Rust SOURCE tree.
#
# SINGLE SOURCE OF TRUTH for source<->binary provenance. The tracked rs/bin Cargo launcher uses
# this fingerprint before and after a cached workspace build, then stores it beside the resulting
# target binary. Two independent hash implementations would themselves be the defect class this
# guards against, so there is deliberately only one.
#
# Output (stdout): a single line, "<64-hex sha256>", covering the WORKING-TREE contents of every
# git-tracked file under rs/ EXCEPT the tracked launcher links in rs/bin and ignored rs/target
# outputs. Any change to Cargo.toml/Cargo.lock or a source file changes the fingerprint; a rebuild
# refreshes the stamp.
# Exits nonzero (no output) if the rs/ source cannot be enumerated, so callers fail closed.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
cd "$ROOT"

# Deterministic order: git ls-files is sorted, but pin the locale so it is stable everywhere.
mapfile -t files < <(git ls-files -- rs ':!rs/bin' ':!rs/target' | LC_ALL=C sort)
if ((${#files[@]} == 0)); then
    echo "rs-source-fingerprint: no tracked rs/ source files found under $ROOT (not a checkout?)" >&2
    exit 3
fi

# One sha256sum process emits both content digests and paths (so renames also move the
# fingerprint); hashing that deterministic stream avoids a subprocess per source file.
sha256sum -- "${files[@]}" | sha256sum | cut -d' ' -f1
