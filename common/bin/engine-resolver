#!/usr/bin/env bash
# TRACKED, deterministic engine resolver for repository-local tool commands.
#
# The paired commands (`dagrun`, `cpuset-alloc`, `tick-hub`, `pr-landing-planner`, `herdr-run`, `herdr-agent`, `herdr-subagents`, and `agentctl`) have tracked Python and Cargo-backed Rust launchers under their respective `*/bin`
# directories. `parallel-experiment-runner` and `herdr-chat` are
# intentionally Python-only. `wrkslots`, `wrkviz`, and `herdr-subagents` are
# Python-primary with a Rust edition opt-in through WRKSLOTS_ENGINE,
# WRKVIZ_ENGINE, and HERDR_SUBAGENTS_ENGINE respectively (see below).
# Every tracked command link in this directory points here, so the top-level `./bin` symlink exposes
# one consistent command surface after any setup mode.
#
# Contract enforced here
# ----------------------
#   * DETERMINISTIC + TRACKED default: with no override, a tool runs its primary edition as
#     declared in validation/editions.json (checked against the tracked links by
#     scripts/check_editions.py); a partial checkout without that file falls back to the tracked
#     `rs/bin` link's presence. No probe of the host decides the engine.
#   * MIRROR STATE: an explicit request for the non-primary edition runs only when
#     validation/editions.json says that mirror is at parity; a paused, archived, or absent
#     mirror refuses (exit 127) and names its state.
#   * The Rust default needs a Rust toolchain: its tracked launcher asks Cargo to validate the
#     workspace cache and provenance before executing, building on first use. Without Cargo the
#     launcher refuses and names the Python opt-in below; it never silently falls back.
#   * Overrides: DAGRUN_ENGINE (historical name; wins when set) and AGENT_UTILS_ENGINE (the clearer
#     name, consulted when DAGRUN_ENGINE is unset) accept `rust`/`rs` or `python`/`py`. An empty
#     value counts as unset, as it always has. An explicit request for an edition a tool does not
#     have refuses (exit 127); anything else is a usage error (exit 2).
#   * LOGS WHICH ENGINE WON on every invocation (one stderr line), so the resolved engine and its
#     exact path are always visible in logs.
#
# The resolved tool name is this script's invocation basename. The tracked links for `dagrun`,
# `cpuset-alloc`, `pr-landing-planner`, `tick-hub`, `wrkviz`,
# `parallel-experiment-runner`, `wrkslots`, `herdr-run`, and `herdr-agent` all point here.
set -euo pipefail

# Locate the agent-utils root from the resolver's REAL path (follow the symlink chain), independent
# of how the tool was invoked. common/bin/engine-resolver -> root is two levels up.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"

TOOL="$(basename "$0")"
if [[ "$TOOL" == "engine-resolver" ]]; then
    echo "engine-resolver: invoke via a tracked tool symlink, not directly" >&2
    exit 2
fi

# Mirror-state model (validation/editions.json, #539 rust-primary-mirror-state): the model is
# authoritative for this tool's primary edition and mirror state. The dispatcher reads the
# generated validation/editions.tsv (one tab-separated line per tool, kept byte-identical to
# the JSON by scripts/check_editions.py) so no JSON parsing happens here. A checkout with the
# JSON but no TSV is inconsistent and refuses; a partial checkout with neither (the resolver's
# sandbox tests) keeps the presence-based fallback below.
EDITIONS_JSON="$ROOT/validation/editions.json"
EDITIONS_TSV="$ROOT/validation/editions.tsv"
ED_PRIMARY=""
ED_MIRROR_STATE=""
ED_PAUSED_AT=""
if [[ -f "$EDITIONS_JSON" && ! -f "$EDITIONS_TSV" ]]; then
    echo "[$TOOL] validation/editions.json is present but its generated validation/editions.tsv is missing. Refusing to dispatch on an inconsistent checkout; regenerate it with python3 scripts/check_editions.py --write-tsv." >&2
    exit 127
fi
if [[ -f "$EDITIONS_TSV" ]]; then
    while IFS=$'\t' read -r ED_NAME ED_PRIMARY ED_MIRROR_STATE ED_PAUSED_AT; do
        if [[ "$ED_NAME" == "$TOOL" ]]; then
            break
        fi
        ED_PRIMARY=""
        ED_MIRROR_STATE=""
        ED_PAUSED_AT=""
    done < "$EDITIONS_TSV"
fi

# Engine selection: an explicit override wins; otherwise the editions primary, else Rust for a
# tool with a tracked Rust launcher, Python for a Python-only tool. Pairing in the fallback is
# decided by the tracked link's PRESENCE, not its executability: a damaged (dangling or
# non-executable) link must fail closed in the Rust leg below, never quietly run Python instead.
ENGINE=""
ENGINE_VAR=""
if [[ -n "${DAGRUN_ENGINE:-}" ]]; then
    ENGINE="$DAGRUN_ENGINE"
    ENGINE_VAR="DAGRUN_ENGINE"
elif [[ -n "${AGENT_UTILS_ENGINE:-}" ]]; then
    ENGINE="$AGENT_UTILS_ENGINE"
    ENGINE_VAR="AGENT_UTILS_ENGINE"
elif [[ -n "$ED_PRIMARY" ]]; then
    ENGINE="$ED_PRIMARY"
elif [[ -e "$ROOT/rs/bin/$TOOL" || -L "$ROOT/rs/bin/$TOOL" ]]; then
    ENGINE="rust"
else
    ENGINE="python"
fi

# wrkslots edition-switch opt-in (#562 rust-primary-wrkslots): WRKSLOTS_ENGINE is the
# per-tool trial switch for the Rust edition growing in wrkslotsd. It wins over the
# generic overrides for this tool only, and it bypasses the mirror-state guard below:
# the Rust edition is not yet a parity mirror, it is an explicit opt-in whose covered
# commands run at differential parity and whose remaining commands refuse by name.
# Unset or empty keeps the Python primary. The default flips only by changing
# validation/editions.json, never by this variable becoming common.
WRKSLOTS_OPTIN=""
WRKSLOTS_SOAK=""
if [[ "$TOOL" == "wrkslots" && -n "${WRKSLOTS_ENGINE:-}" ]]; then
    if [[ "$WRKSLOTS_ENGINE" == "rust-soak" ]]; then
        # Soak mode (#562): dispatch through the soak launcher, which
        # accepts the exact Python CLI and logs every invocation. An
        # explicit soak request against a checkout without the launcher
        # refuses by name instead of silently running another edition.
        if [[ ! -x "$ROOT/common/bin/wrkslots-soak" ]]; then
            echo "[wrkslots] engine=rust-soak requested but no executable soak launcher exists at common/bin/wrkslots-soak. Refusing to silently fall back to Python." >&2
            exit 127
        fi
        exec "$ROOT/common/bin/wrkslots-soak" "$@"
    fi
    ENGINE="$WRKSLOTS_ENGINE"
    ENGINE_VAR="WRKSLOTS_ENGINE"
    WRKSLOTS_OPTIN="1"
fi

# wrkslots Rust readers routing (#562 early flip, soak phase): with no
# explicit engine override of any kind, dispatch through the soak
# launcher in readers-only mode when opted in per process
# (WRKSLOTS_RUST_READERS=1) or for a listed project by a per-host
# scoped file (${WRKSLOTS_RUST_READERS_FILE:-~/.local/etc/agent-utils/
# wrkslots-rust-readers}, a file that is not synced between hosts):
#
#   readers = scoped
#   project = /absolute/project/root
#
# The legacy bare `enabled = true` line is ignored on purpose: an older
# resolver that only knows that spelling must stay off rather than route
# every project on the host. Code default is OFF: neither opt-in,
# nothing changes. WRKSLOTS_ENGINE=python (or WRKSLOTS_RUST_READERS=0)
# opts back out. Routed calls are logged by the soak launcher
# (WRKSLOTS_SOAK_LOG, default ~/.local/state/wrkslots-soak/soak.log).
_wrkslots_readers_config_value() {
    local file="$1" key="$2" line value
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*\"?${key}\"?[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then
            printf '%s' "${BASH_REMATCH[1]}"
            return 0
        fi
        if [[ "$line" =~ ^[[:space:]]*\"?${key}\"?[[:space:]]*:[[:space:]]*([^#\ ,}]+) ]]; then
            value="${BASH_REMATCH[1]}"
            value="${value%\"}"
            value="${value#\"}"
            printf '%s' "$value"
            return 0
        fi
    done < "$file"
    return 1
}

_wrkslots_readers_authoritative_root() {
    local root="$1" config="$1/.wrkslots.yml" worktrees_value layout_value control pattern
    [[ -L "$config" ]] && return 0
    worktrees_value="$(_wrkslots_readers_config_value "$config" worktrees_dir 2>/dev/null)" || return 0
    layout_value="$(_wrkslots_readers_config_value "$config" layout 2>/dev/null)" || layout_value="nested"
    if [[ -z "$worktrees_value" || "$worktrees_value" == /* || "$worktrees_value" == "." \
        || "$worktrees_value" == ".." || "$worktrees_value" == ../* \
        || "$worktrees_value" == */.. || "$worktrees_value" == */../* \
        || ( "$layout_value" != "nested" && "$layout_value" != "flat" ) ]]; then
        return 0
    fi
    control="$(readlink -m -- "$root/$worktrees_value")"
    [[ "$layout_value" == "flat" ]] && control="$(dirname -- "$control")"
    [[ -L "$control/wrkslots" ]] && return 0
    for pattern in 'ACTIVE.*.json' 'ARCHIVED.*.json' 'ACTIVE.*.journal' \
                   'CREATE.*.journal' 'FINISH.*.journal' \
                   'VALIDATE-BATCH-SEAL.*.journal' 'EVENTS.*'; do
        compgen -G "$control/$pattern" >/dev/null && return 0
    done
    return 1
}

_wrkslots_readers_project_root() {
    local explicit="${1:-}" candidate fallback=""
    if [[ -n "$explicit" ]]; then
        if [[ -d "$explicit" && ! -L "$explicit" ]]; then
            (cd -- "$explicit" && pwd -P)
        fi
        return
    fi
    candidate="$(pwd -P)"
    while :; do
        if [[ -e "$candidate/.wrkslots.yml" || -L "$candidate/.wrkslots.yml" ]]; then
            fallback="$candidate"
            if _wrkslots_readers_authoritative_root "$candidate"; then
                printf '%s' "$candidate"
                return
            fi
        fi
        [[ "$candidate" == "/" ]] && break
        candidate="$(dirname -- "$candidate")"
    done
    printf '%s' "$fallback"
}

if [[ "$TOOL" == "wrkslots" && -z "${WRKSLOTS_ENGINE:-}" && -z "$ENGINE_VAR" ]]; then
    WRKSLOTS_READERS=""
    case "${WRKSLOTS_RUST_READERS:-}" in
        1|true) WRKSLOTS_READERS="1" ;;
        0|false) WRKSLOTS_READERS="" ;;
        *)
            READERS_FILE="${WRKSLOTS_RUST_READERS_FILE:-$HOME/.local/etc/agent-utils/wrkslots-rust-readers}"
            if [[ -f "$READERS_FILE" ]] \
                && grep -Eq '^[[:space:]]*readers[[:space:]]*=[[:space:]]*scoped([[:space:]]*(#.*)?)?$' "$READERS_FILE"; then
                # Parse only the leading wrkslots globals, mirroring the
                # Python CLI, to learn the command and explicit root.
                READERS_ARGS=("$@")
                READERS_INDEX=0
                READERS_EXPLICIT_ROOT=""
                while (( READERS_INDEX < ${#READERS_ARGS[@]} )); do
                    case "${READERS_ARGS[READERS_INDEX]}" in
                        --project-root)
                            if (( READERS_INDEX + 1 >= ${#READERS_ARGS[@]} )); then
                                break
                            fi
                            READERS_EXPLICIT_ROOT="${READERS_ARGS[READERS_INDEX + 1]}"
                            READERS_INDEX=$((READERS_INDEX + 2))
                            ;;
                        --project-root=*)
                            READERS_EXPLICIT_ROOT="${READERS_ARGS[READERS_INDEX]#--project-root=}"
                            READERS_INDEX=$((READERS_INDEX + 1))
                            ;;
                        --machine|--wait-lock)
                            if (( READERS_INDEX + 1 >= ${#READERS_ARGS[@]} )); then
                                break
                            fi
                            READERS_INDEX=$((READERS_INDEX + 2))
                            ;;
                        --machine=*|--wait-lock=*|--allow-existing-unregistered-worktrees)
                            READERS_INDEX=$((READERS_INDEX + 1))
                            ;;
                        *) break ;;
                    esac
                done
                READERS_COMMAND="${READERS_ARGS[READERS_INDEX]:-}"
                case "$READERS_COMMAND" in
                    status|doctor|unpushed|shell-command|quickstart)
                        READERS_PROJECT_ROOT="$(_wrkslots_readers_project_root "$READERS_EXPLICIT_ROOT")"
                        READERS_LISTED=""
                        if [[ -n "$READERS_PROJECT_ROOT" ]]; then
                            while IFS= read -r READERS_LINE || [[ -n "$READERS_LINE" ]]; do
                                if [[ "$READERS_LINE" =~ ^[[:space:]]*project[[:space:]]*=[[:space:]]*(.*)[[:space:]]*$ ]]; then
                                    READERS_LISTED_PATH="${BASH_REMATCH[1]}"
                                    if [[ "$READERS_LISTED_PATH" == \"*\" && "$READERS_LISTED_PATH" == *\" ]] \
                                        || [[ "$READERS_LISTED_PATH" == \'*\' && "$READERS_LISTED_PATH" == *\' ]]; then
                                        READERS_LISTED_PATH="${READERS_LISTED_PATH:1:-1}"
                                    fi
                                    if [[ "$READERS_LISTED_PATH" == /* && "$(readlink -m -- "$READERS_LISTED_PATH")" == "$READERS_PROJECT_ROOT" ]]; then
                                        READERS_LISTED="1"
                                        break
                                    fi
                                fi
                            done < "$READERS_FILE"
                        fi
                        if [[ -n "$READERS_LISTED" ]]; then
                            WRKSLOTS_READERS="1"
                        elif [[ -n "$READERS_PROJECT_ROOT" ]]; then
                            echo "[wrkslots] readers soak skipped: project $READERS_PROJECT_ROOT is not listed in scoped host opt-in; running Python" >&2
                        else
                            echo "[wrkslots] readers soak skipped: project root not found for scoped host opt-in; running Python" >&2
                        fi
                        ;;
                esac
            fi
            ;;
    esac
    if [[ -n "$WRKSLOTS_READERS" ]]; then
        if [[ -x "$ROOT/common/bin/wrkslots-soak" ]]; then
            export WRKSLOTS_SOAK_READERS_ONLY=1
            exec "$ROOT/common/bin/wrkslots-soak" "$@"
        fi
        # The host opt-in must never break a partial checkout (or a test
        # sandbox) that has no soak launcher: stay on the normal path.
        echo "[wrkslots] rust readers routing requested but soak launcher missing at common/bin/wrkslots-soak; running Python" >&2
    fi
fi

# wrkviz edition-switch opt-in (#706 rust-primary-wrkviz): WRKVIZ_ENGINE is the
# per-tool trial switch for the Rust edition growing in rs/wrkviz. It wins over
# the generic overrides for this tool only, and it bypasses the mirror-state
# guard below: the Rust edition is not yet a parity mirror, it is an explicit
# opt-in whose covered commands run at differential parity and whose remaining
# commands refuse by name. Unset or empty keeps the Python primary. The
# default flips only by changing validation/editions.json, never by this
# variable becoming common.
WRKVIZ_OPTIN=""
if [[ "$TOOL" == "wrkviz" && -n "${WRKVIZ_ENGINE:-}" ]]; then
    ENGINE="$WRKVIZ_ENGINE"
    ENGINE_VAR="WRKVIZ_ENGINE"
    WRKVIZ_OPTIN="1"
fi

# herdr-subagents edition-switch opt-in (#545 herdr-subagents-port):
# HERDR_SUBAGENTS_ENGINE is the per-tool trial switch for the Rust edition
# growing in rs/agentctl (foreign module). It wins over the generic
# overrides for this tool only, and it bypasses the mirror-state guard
# below: the Rust edition is not yet a parity mirror, it is an explicit
# opt-in whose covered commands run at parity and whose remaining
# commands refuse by name. Unset or empty keeps the Python primary. The
# default flips only by changing validation/editions.json, never by this
# variable becoming common.
SUBAGENTS_OPTIN=""
if [[ "$TOOL" == "herdr-subagents" && -n "${HERDR_SUBAGENTS_ENGINE:-}" ]]; then
    ENGINE="$HERDR_SUBAGENTS_ENGINE"
    ENGINE_VAR="HERDR_SUBAGENTS_ENGINE"
    SUBAGENTS_OPTIN="1"
fi

# An explicit request for the mirror edition is honoured only at parity. A paused, archived, or
# absent mirror refuses by name and state instead of silently running stale code.
if [[ -z "$WRKSLOTS_OPTIN" && -z "$WRKVIZ_OPTIN" && -z "$SUBAGENTS_OPTIN" && -n "$ENGINE_VAR" && -n "$ED_PRIMARY" && -n "$ED_MIRROR_STATE" ]]; then
    case "$ENGINE" in
        python|py) REQUESTED="python" ;;
        rust|rs) REQUESTED="rust" ;;
        *) REQUESTED="" ;;
    esac
    if [[ -n "$REQUESTED" && "$REQUESTED" != "$ED_PRIMARY" && "$ED_MIRROR_STATE" != "parity" ]]; then
        DETAIL="a $ED_MIRROR_STATE mirror"
        if [[ "$ED_MIRROR_STATE" == "absent" || "$ED_MIRROR_STATE" == "archived" ]]; then
            DETAIL="an $ED_MIRROR_STATE mirror"
        elif [[ "$ED_MIRROR_STATE" == "paused" && -n "$ED_PAUSED_AT" ]]; then
            DETAIL="a paused mirror (paused at $ED_PAUSED_AT)"
        fi
        echo "[$TOOL] engine=$REQUESTED refused: the $REQUESTED edition of $TOOL is $DETAIL (primary: $ED_PRIMARY; see validation/editions.json). Refusing to silently fall back." >&2
        exit 127
    fi
fi

case "$ENGINE" in
    python|py)
        TARGET="$ROOT/py/bin/$TOOL"
        if [[ ! -e "$TARGET" ]]; then
            echo "[$TOOL] engine=python: no tracked entrypoint at py/bin/$TOOL. Refusing to silently fall back to Rust; run it with ${ENGINE_VAR:-DAGRUN_ENGINE}=rust or no override." >&2
            exit 127
        fi
        echo "[$TOOL] engine=python (tracked entrypoint: py/bin/$TOOL)" >&2
        exec "${CI_HUB_PYTHON:-python3}" "$TARGET" "$@"
        ;;
    rust|rs)
        # The tracked rs/bin link invokes the shared Cargo/provenance launcher. It verifies the
        # workspace cache on every invocation (a clean committed tree takes its fast warm path;
        # anything else gets the full content fingerprint under a lock), rejects replaced
        # artifacts, and rebuilds stale source before exec. Never fall back to Python silently;
        # that would re-hide an engine mismatch.
        TARGET="$ROOT/rs/bin/$TOOL"
        if [[ -n "$WRKSLOTS_OPTIN" ]]; then
            # The wrkslots Rust edition ships as the wrkslotsd binary.
            TARGET="$ROOT/rs/bin/wrkslotsd"
        fi
        if [[ -n "$WRKVIZ_OPTIN" ]]; then
            # The wrkviz Rust edition ships as the wrkvizd binary.
            TARGET="$ROOT/rs/bin/wrkvizd"
        fi
        if [[ ! -x "$TARGET" ]]; then
            if [[ -e "$TARGET" || -L "$TARGET" ]]; then
                echo "[$TOOL] engine=rust but the tracked launcher at ${TARGET#"$ROOT"/} is not executable. Refusing to silently fall back to Python. Fix the checkout (it must be the tracked symlink to cargo-runner), or run the Python edition with ${ENGINE_VAR:-DAGRUN_ENGINE}=python." >&2
            else
                echo "[$TOOL] engine=rust requested but no tracked launcher exists at ${TARGET#"$ROOT"/}. Refusing to silently fall back to Python. $TOOL is Python-only: run it with no override or with ${ENGINE_VAR:-DAGRUN_ENGINE}=python." >&2
            fi
            exit 127
        fi
        echo "[$TOOL] engine=rust (tracked Cargo launcher: ${TARGET#"$ROOT"/})" >&2
        unset AGENT_UTILS_RS_ENSURE_ONLY
        if [[ "$TOOL" == "wrkslots" ]]; then
            # Routed as the wrkslots Rust edition: wrkslotsd translates
            # exact Python spellings in this mode (#562 P10).
            export WRKSLOTS_PYCOMPAT=1
        fi
        exec "$TARGET" "$@"
        ;;
    *)
        echo "[$TOOL] $ENGINE_VAR='$ENGINE' is invalid (want 'python' or 'rust')" >&2
        exit 2
        ;;
esac
