#!/usr/bin/env bash
# TRACKED, deterministic engine resolver for agent-utils tools.
#
# Why this exists
# ---------------
# Several agent-utils tools ship two implementations: a TRACKED Python entrypoint
# (`py/bin/<tool>`, a versioned symlink into the package) and, for `safe-ci-dag-runner`, an
# UNTRACKED Rust build artifact (`rs/bin/<tool>` / `rs/target/release/<tool>`, produced by
# `./setup rs`). The old `./setup both` wired the top-level `./bin` symlink straight at `rs/bin`,
# so `./agent-utils/bin/<tool>` silently ran whatever Rust binary was last built — an UNTRACKED,
# possibly STALE artifact silently beating the tracked entrypoint, with nothing logging which
# engine actually ran. That is exactly how a Rust runner missing an enforcement guard (the
# historical `cpu_timeout` gap) can run in production unnoticed.
#
# Contract enforced here
# ----------------------
#   * DETERMINISTIC + TRACKED default: with no override, ALWAYS the tracked Python entrypoint.
#   * Rust is opt-in ONLY, via SAFE_CI_DAG_RUNNER_ENGINE=rust, and is NEVER a silent fallback:
#     if Rust is requested but not built, this errors instead of quietly running Python.
#   * LOGS WHICH ENGINE WON on every invocation (one stderr line), so the resolved engine and its
#     exact path are always visible in logs.
#
# The resolved tool name is this script's invocation basename (the wired symlinks
# `safe-ci-dag-runner` / `pr-landing-planner` / `tick-hub` / `agent-team-timeline` all point here).
set -euo pipefail

# Locate the agent-utils root from the resolver's REAL path (follow the symlink chain), independent
# of how the tool was invoked. common/bin/engine-resolver -> root is two levels up.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"

TOOL="$(basename "$0")"
if [[ "$TOOL" == "engine-resolver" ]]; then
    echo "engine-resolver: invoke via a tool symlink (safe-ci-dag-runner|pr-landing-planner|tick-hub|agent-team-timeline), not directly" >&2
    exit 2
fi

# Deterministic default: the TRACKED Python entrypoint. Rust is explicit opt-in only.
ENGINE="${SAFE_CI_DAG_RUNNER_ENGINE:-python}"

case "$ENGINE" in
    python|py)
        TARGET="$ROOT/py/bin/$TOOL"
        if [[ ! -e "$TARGET" ]]; then
            echo "[$TOOL] engine=python: no tracked entrypoint at py/bin/$TOOL" >&2
            exit 127
        fi
        echo "[$TOOL] engine=python (tracked entrypoint: py/bin/$TOOL)" >&2
        exec "${CI_HUB_PYTHON:-python3}" "$TARGET" "$@"
        ;;
    rust|rs)
        # Rust binaries are UNTRACKED build artifacts. Use ONLY when explicitly requested, present,
        # AND content-verified against the currently-pinned source. A binary built from source older
        # than the pinned gitlink (a warm/stale artifact) or a binary swapped in without a rebuild is
        # REFUSED, never silently run — that is exactly how a runner missing an enforcement guard can
        # run while we believe the tracked source is executing. Never fall back to Python silently
        # either; that would re-hide the engine mismatch.
        TARGET="$ROOT/rs/bin/$TOOL"
        if [[ ! -x "$TARGET" ]]; then
            echo "[$TOOL] engine=rust requested but no built binary at rs/bin/$TOOL; run './setup rs'. Refusing to silently fall back to Python." >&2
            exit 127
        fi
        # Content-verify against build provenance stamped by `setup rs`.
        prov="$TARGET.provenance"
        if [[ ! -f "$prov" ]]; then
            echo "[$TOOL] engine=rust REFUSED: no build provenance ($TOOL.provenance). The UNTRACKED binary cannot be verified against pinned source; rebuild with './setup rs'." >&2
            exit 3
        fi
        want_src="$(sed -n 's/^source_fp=//p' "$prov")"
        want_bin="$(sed -n 's/^binary_sha256=//p' "$prov")"
        if [[ -z "$want_src" || -z "$want_bin" ]]; then
            echo "[$TOOL] engine=rust REFUSED: malformed provenance ($TOOL.provenance); rebuild with './setup rs'." >&2
            exit 3
        fi
        have_src="$("$ROOT/common/bin/rs-source-fingerprint")"
        have_bin="$(sha256sum -- "$TARGET" | cut -d' ' -f1)"
        if [[ "$have_src" != "$want_src" ]]; then
            echo "[$TOOL] engine=rust REFUSED: STALE binary — built from source ${want_src:0:12} but pinned source is now ${have_src:0:12}. Rebuild with './setup rs'." >&2
            exit 3
        fi
        if [[ "$have_bin" != "$want_bin" ]]; then
            echo "[$TOOL] engine=rust REFUSED: binary ${TARGET#"$ROOT"/} does not match its provenance (have ${have_bin:0:12}, want ${want_bin:0:12}) — modified/planted artifact. Rebuild with './setup rs'." >&2
            exit 3
        fi
        echo "[$TOOL] engine=rust (source-verified ${have_src:0:12}: ${TARGET#"$ROOT"/})" >&2
        exec "$TARGET" "$@"
        ;;
    *)
        echo "[$TOOL] SAFE_CI_DAG_RUNNER_ENGINE='$ENGINE' is invalid (want 'python' or 'rust')" >&2
        exit 2
        ;;
esac
