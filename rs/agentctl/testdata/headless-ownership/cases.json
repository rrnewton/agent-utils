{
  "schema": "agentctl-headless-ownership-corpus/v1",
  "description": "Shared by both agentctl editions: the Python runtime's recorded_liveness and the Rust turn-runner retirement proof must reach each verdict from the same runtime records and procfs state. Placeholders: $BOOT (the current boot), $OTHER_BOOT, $CGROUP (a test directory standing in for the cgroup v2 parent). The registry has one row for 'worker' (runner pid 4242, start tick 555) unless a case sets row to null.",
  "boot": "11111111-2222-4333-8444-555555555555",
  "other_boot": "99999999-8888-4777-8666-555555555555",
  "cases": [
    {
      "name": "no-live-process",
      "why": "the recorded runner no longer exists",
      "files": {},
      "processes": [],
      "cgroups": {},
      "expect": "dead"
    },
    {
      "name": "runner-alive",
      "why": "the row's runner pid still has its recorded start tick",
      "files": {},
      "processes": [
        {
          "pid": 4242,
          "start": 555,
          "state": "S"
        }
      ],
      "cgroups": {},
      "expect": "alive"
    },
    {
