# Installed by `agentctl install-units`. Restores the coordinator team once per boot.
#
# `agentctl restore` is idempotent: it exits at once when this boot's report already says the
# restore completed, revives only dead agents, and queues one recovery notice per boot.
[Unit]
Description=Restore the agentctl coordinator team after boot
Requires=herdr-server.service
After=herdr-server.service
# A refused restore (exit 75, temporary failure) retries a bounded number of
# times instead of giving up for the boot (#975 boot-restore-retry).
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=@AGENTCTL@ --registry @REGISTRY@ --herdr-bin @HERDR@ restore --boot
# Reviving each agent can take its startup deadline plus the configured delay between agents.
TimeoutStartSec=1800
Restart=on-failure
RestartSec=60
# Exit 74 means the restore completed except for refused lanes named in the
# report; retrying cannot revive them, so it counts as success (#948).
SuccessExitStatus=74
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
