# Installed by `agentctl install-units --tab-hygiene` (#1971 agentctl-tabs-scheduled-hygiene).
# Runs the tab-hygiene service shortly after boot and then every five
# minutes while the host stays up.
[Unit]
Description=agentctl tab hygiene timer
ConditionHost=@HOST@

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=@UNIT@.service

[Install]
WantedBy=timers.target
