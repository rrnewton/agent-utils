# Installed by `agentctl install-units --tab-hygiene` (#1971 agentctl-tabs-scheduled-hygiene).
# Runs agentctl-tab-hygiene.service shortly after boot and then every five
# minutes. Persistent=true fires a run missed while the host was off, so a
# reboot does not silently skip a period.
[Unit]
Description=agentctl tab hygiene timer
ConditionHost=@HOST@

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Unit=agentctl-tab-hygiene.service
Persistent=true

[Install]
WantedBy=timers.target
