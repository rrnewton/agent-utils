{
  "schema": "change-classifier-vectors/v1",
  "_comment": "The shared contract for glob and rule-order semantics. A change to any expectation here must also pass a replay over every consumer's history, and their owners are told before it lands. Names are neutral stand-ins.",
  "globs": [
    {"pattern": "Cargo.toml", "path": "Cargo.toml", "match": true, "note": "exact"},
    {"pattern": "Cargo.toml", "path": "core/Cargo.toml", "match": false, "note": "a pattern without / is not a suffix"},
    {"pattern": "*.md", "path": "README.md", "match": true, "note": "star within a segment"},
    {"pattern": "*.md", "path": "docs/x.md", "match": false, "note": "star does not cross /"},
    {"pattern": "docs/**", "path": "docs/a/b/c.md", "match": true, "note": "double star spans directories"},
    {"pattern": "docs/**", "path": "docs", "match": false, "note": "dir/** needs something under dir"},
    {"pattern": "**/*.rs", "path": "core/src/scheduler.rs", "match": true},
    {"pattern": "**/*.rs", "path": "main.rs", "match": true, "note": "**/ matches zero directories"},
    {"pattern": "core/**/*.rs", "path": "core/src/a/b.rs", "match": true},
    {"pattern": "core/**/*.rs", "path": "core/lib.rs", "match": true},
    {"pattern": "core/**/*.rs", "path": "cli/src/a.rs", "match": false},
    {"pattern": "engine-fast/**", "path": "engine-fast/src/lib.rs", "match": true},
    {"pattern": "engine-fast/**", "path": "engine-fast/Cargo.toml", "match": true},
    {"pattern": "engine-fast/**", "path": "engine-fast-sys/lib.rs", "match": false, "note": "a directory, not a prefix"},
    {"pattern": "a?c", "path": "abc", "match": true},
    {"pattern": "a?c", "path": "a/c", "match": false, "note": "? does not match /"},
    {"pattern": "a/**/z.c", "path": "a/b/c/z.c", "match": true},
    {"pattern": "a/**/z.c", "path": "a/z.c", "match": true, "note": "mid double star matches zero directories"},
    {"pattern": "**", "path": "anything/at/all", "match": true},
    {"pattern": "**", "path": "top", "match": true},
    {"pattern": "*", "path": "a/b", "match": false},
    {"pattern": "a*", "path": "a", "match": true, "note": "star matches the empty run"},
    {"pattern": "**/NAME", "path": "deep/dir/NAME", "match": true},
    {"pattern": "**/NAME", "path": "NAME", "match": true},
    {"pattern": "**/NAME", "path": "deep/dir/NAMED", "match": false},
    {"pattern": ".github/actions/**", "path": ".github/actions/setup/action.yml", "match": true, "note": "dots are literal"},
    {"pattern": "src/*.rs", "path": "src/.rs", "match": true},
    {"pattern": "", "path": "", "match": true},
    {"pattern": "", "path": "a", "match": false}
  ],
  "name_status": [
    {"input": "M\tcore/src/a.rs\nA\tdocs/new.md", "paths": ["core/src/a.rs", "docs/new.md"]},
    {"input": "R087\tcore/src/old.rs\tengine-fast/src/new.rs", "paths": ["core/src/old.rs", "engine-fast/src/new.rs"], "note": "a rename counts both sides"},
    {"input": "C100\tsrc/a.rs\tsrc/b.rs", "paths": ["src/a.rs", "src/b.rs"]},
    {"input": "plain/path.rs\n\nD\tgone.rs", "paths": ["plain/path.rs", "gone.rs"], "note": "bare paths pass through; blank lines are skipped"}
  ],
  "policies": {
    "sample": {
      "version": 2,
      "force_full": ["Cargo.toml", "Cargo.lock", "toolchain.toml", "ci/**", ".github/actions/**"],
      "ci_irrelevant": ["**/*.md", "docs/**", "notes/**", "**/*.png"],
      "groups": {"LINT": ["lint.fmt", "lint.clippy"]},
      "footprints": [
        {"paths": ["core/**/*.rs", "core/Cargo.toml"], "nodes": ["build.workspace", "test.core", "@LINT"], "e2e_all": true},
        {"paths": ["cli/**"], "nodes": ["test.cli"], "component": "command-line"},
        {"paths": ["tests/c/**"], "nodes": ["check.parity"]},
        {"paths": ["**/*.json"], "nodes": ["check.schemas"]}
      ],
      "backend_rules": [
        {"id": "fast", "tier": "backend", "paths": ["engine-fast/**"], "vendor_paths": ["fast-sys/**"], "backends": ["fast"], "lanes": ["fast-lane"], "extra_nodes": ["test.fast", "e2e.fast"]},
        {"id": "quiet", "tier": "backend", "paths": ["engine-quiet/**"], "backends": ["*"], "lanes": [], "extra_nodes": []},
        {"id": "shared", "tier": "core", "paths": [], "vendor_paths": ["shared/**"], "backends": ["*"], "lanes": ["all-lanes"], "extra_nodes": []}
      ]
    }
  },
  "classify": [
    {"name": "docs only skips", "policy": "sample", "paths": ["notes/x.md", "docs/y.md", "README.md"],
     "expect": {"verdict": "skip", "nodes": [], "classes": ["inert", "inert", "inert"], "unknown": []}},
    {"name": "no paths is full", "policy": "sample", "paths": [],
     "expect": {"verdict": "full", "nodes": []}},
    {"name": "the lock file forces full", "policy": "sample", "paths": ["Cargo.lock"],
     "expect": {"verdict": "full", "classes": ["force-full"]}},
    {"name": "the CI tree forces full", "policy": "sample", "paths": ["ci/dag/validate.json"],
     "expect": {"verdict": "full", "classes": ["force-full"], "nodes": []}},
    {"name": "force_full is checked before footprints", "policy": "sample", "paths": ["ci/schema.json", "core/src/a.rs"],
     "expect": {"verdict": "full", "classes": ["force-full", "matched"], "components": ["core"]}},
    {"name": "a footprint selects its nodes with groups expanded", "policy": "sample", "paths": ["core/src/a.rs"],
     "expect": {"verdict": "selective", "nodes": ["build.workspace", "test.core", "lint.fmt", "lint.clippy"], "e2e_all": true, "components": ["core"]}},
    {"name": "a markdown file under a footprint is matched, not inert", "policy": "sample", "paths": ["cli/README.md"],
     "expect": {"verdict": "selective", "nodes": ["test.cli"], "classes": ["matched"], "components": ["command-line"]}},
    {"name": "every matching footprint contributes", "policy": "sample", "paths": ["tests/c/case.json"],
     "expect": {"verdict": "selective", "nodes": ["check.parity", "check.schemas"], "components": ["tests", "footprint-3"]}},
    {"name": "inert paths beside a footprint hit stay selective", "policy": "sample", "paths": ["docs/a.md", "cli/src/main.rs"],
     "expect": {"verdict": "selective", "nodes": ["test.cli"], "classes": ["inert", "matched"]}},
    {"name": "an unknown path forces full", "policy": "sample", "paths": ["cli/src/main.rs", "scripts/new.sh"],
     "expect": {"verdict": "full", "unknown": ["scripts/new.sh"], "classes": ["matched", "unknown"]}},
    {"name": "a backend rule selects its nodes and scopes its backend", "policy": "sample", "paths": ["engine-fast/src/lib.rs"],
     "expect": {"verdict": "selective", "nodes": ["test.fast", "e2e.fast"], "e2e_backends": ["fast"], "backend_rules": ["fast"], "backend_lanes": ["fast-lane"], "components": ["backend:fast"], "e2e_all": false}},
    {"name": "a scoped key matches paths under its directory", "policy": "sample", "paths": ["vendor/fast-sys/src/lib.rs"],
     "expect": {"verdict": "selective", "backend_rules": ["fast"], "nodes": ["test.fast", "e2e.fast"]}},
    {"name": "a scoped glob does not match outside its directory", "policy": "sample", "paths": ["fast-sys/src/lib.rs"],
     "expect": {"verdict": "full", "unknown": ["fast-sys/src/lib.rs"]}},
    {"name": "a core-tier rule forces full and still reports its lanes", "policy": "sample", "paths": ["vendor/shared/src/lib.rs"],
     "expect": {"verdict": "full", "backend_rules": ["shared"], "backend_lanes": ["all-lanes"], "classes": ["matched"]}},
    {"name": "a backend rule with no nodes is not inert and gives full", "policy": "sample", "paths": ["engine-quiet/src/lib.rs"],
     "expect": {"verdict": "full", "nodes": [], "backend_rules": ["quiet"], "e2e_backends": []}},
    {"name": "the core rule wins over a selective backend rule", "policy": "sample", "paths": ["engine-fast/src/lib.rs", "vendor/shared/x.rs"],
     "expect": {"verdict": "full", "backend_rules": ["fast", "shared"], "backend_lanes": ["fast-lane", "all-lanes"]}},
    {"name": "a renamed file counts at both ends", "policy": "sample", "paths": ["core/src/old.rs", "engine-fast/src/new.rs"],
     "expect": {"verdict": "selective", "components": ["core", "backend:fast"], "e2e_all": true}}
  ]
}
