# --- build outputs (produced by ./setup) ---
# top-level convenience symlink -> the tracked common dispatcher
/bin
/rs/target/
/rs/.agent-utils-locks/
/rs/.agent-utils-snapshots/

# --- python ---
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# --- default profile store (safe-ci-dag-runner Feature D auto-logging) ---
# Runs and sweeps auto-append resource-usage CSVs here by default; it is machine-local
# perf data, not source. Delete this line to check the history in instead (project choice).
.safe-ci-dag-runner/

# --- default run spool + audit log (herdr-run) ---
# Command stdout/stderr/exit codes and the sandbox-crossing audit log land here by default; it is
# machine-local command OUTPUT, not source, and must never be committed.
.herdr-run/

# --- default fired-state store (tick-hub) ---
# `tick-hub tick --flush` writes per-reminder last-fired epochs here by default; it is
# machine-local runtime state, not source.
.tick-hub/

# --- editor / os ---
*.swp
.DS_Store
