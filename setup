#!/usr/bin/env bash
# agent-utils build/setup driver.
#
# Usage:
#   ./setup            build BOTH python and rust (default)
#   ./setup both       same
#   ./setup py         python only: mypy-strict typecheck
#   ./setup rs         rust only:   cargo build --release -> rs/bin
#   ./setup rs --clean rust, then remove rs/target (standalone binaries remain in rs/bin)
#
# Every mode wires ./bin at the TRACKED engine resolver (common/bin). The resolver runs the tracked
# Python entrypoint by default and the UNTRACKED Rust binary only on explicit
# SAFE_CI_DAG_RUNNER_ENGINE=rust, logging which engine won on every invocation.
#
# `make` just calls `./setup`.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Absolute path to this script, resolved BEFORE `cd`, so `--help` works no matter
# how the script was invoked (e.g. `agent-utils/setup -h` by relative path from a
# parent directory, which used to break `sed ... "$0"` after the cd).
SELF="$ROOT/$(basename -- "${BASH_SOURCE[0]}")"
cd "$ROOT"

# Embed each tool's user guide INTO its package/crate from the single source
# common/docs/<tool>/USER_GUIDE.md, so `<tool> --userguide` survives `pip install` / `cargo install`
# (common/docs/ is NOT shipped). Run for BOTH languages regardless of the py/rs/both selection so a
# fresh checkout/build always has the embedded guides present. Idempotent: no-op when in sync.
embed_userguides() {
  echo "==> [docs] embed user guides (single source: common/docs/<tool>/USER_GUIDE.md)"
  command -v python3 >/dev/null || { echo "docs: python3 not found (needed to embed guides)" >&2; return 1; }
  python3 "$ROOT/scripts/embed_userguides.py"
}

WHAT="both"
CLEAN=0
for arg in "$@"; do
  case "$arg" in
    py|rs|both) WHAT="$arg" ;;
    --clean)    CLEAN=1 ;;
    -h|--help)  sed -n '1d;/^set -/q;s/^# \{0,1\}//p' "$SELF"; exit 0 ;;
    *) echo "setup: unknown arg: $arg (want py|rs|both [--clean])" >&2; exit 2 ;;
  esac
done

setup_py() {
  echo "==> [py] mypy strict typecheck + wire bin"
  command -v python3 >/dev/null || { echo "py: python3 not found" >&2; return 1; }
  if ! python3 -m mypy --version >/dev/null 2>&1; then
    echo "py: mypy not installed. Install it (e.g. 'with-proxy pip install mypy')." >&2
    return 1
  fi
  ( cd py && python3 -m mypy . )
  [ -d py/bin ] && chmod +x py/bin/* 2>/dev/null || true
  # Smoke-check that every entrypoint starts cleanly with zero optional deps (stdlib-only; catches
  # an optional dependency imported at module scope taking down `--help` on a bare host).
  echo "==> [py] check-deps (dependency-free entrypoint smoke test)"
  python3 "$ROOT/scripts/check_deps.py"
  echo "==> [py] ok"
}

setup_rs() {
  echo "==> [rs] cargo build --release --workspace"
  command -v cargo >/dev/null || { echo "rs: cargo not found" >&2; return 1; }
  cargo build --release --workspace --manifest-path rs/Cargo.toml
  mkdir -p rs/bin
  # Copy each workspace bin target into rs/bin so the binaries are standalone and
  # rs/target can be deleted. Bin names are discovered from cargo metadata.
  python3 - "$ROOT" <<'PY'
import json, os, shutil, subprocess, sys
root = sys.argv[1]
manifest = os.path.join(root, "rs", "Cargo.toml")
meta = json.loads(subprocess.check_output(
    ["cargo", "metadata", "--format-version", "1", "--no-deps", "--manifest-path", manifest]))
rel = os.path.join(root, "rs", "target", "release")
binroot = os.path.join(root, "rs", "bin")
os.makedirs(binroot, exist_ok=True)
installed = []
for pkg in meta["packages"]:
    for tgt in pkg["targets"]:
        if "bin" in tgt["kind"]:
            src = os.path.join(rel, tgt["name"])
            if os.path.exists(src):
                dst = os.path.join(binroot, tgt["name"])
                shutil.copy2(src, dst)
                os.chmod(dst, 0o755)
                installed.append(tgt["name"])
print("rs: installed binaries:", ", ".join(sorted(installed)) or "(none)")
PY
  if [ "$CLEAN" = 1 ]; then echo "==> [rs] --clean: removing rs/target"; rm -rf rs/target; fi
  echo "==> [rs] ok"
}

wire_bin() { rm -f bin; ln -s "$1" bin; echo "==> ./bin -> $1"; }

embed_userguides
case "$WHAT" in
  py)   setup_py ;;
  rs)   setup_rs ;;
  both) setup_py; setup_rs ;;
esac
# Wire ./bin at the TRACKED, deterministic engine resolver (common/bin) regardless of what was
# built. The resolver defaults to the tracked Python entrypoint and runs Rust ONLY on explicit
# SAFE_CI_DAG_RUNNER_ENGINE=rust (never a silent fallback), logging which engine won on every run.
# This replaces the old footgun where `both` wired ./bin straight at the UNTRACKED rs/bin, letting a
# stale locally-built Rust binary silently beat the tracked entrypoint.
wire_bin "common/bin"
if [ "$WHAT" = rs ]; then
  echo "==> note: run Rust via SAFE_CI_DAG_RUNNER_ENGINE=rust ./bin/safe-ci-dag-runner (default is tracked Python)"
fi
echo "setup: done ($WHAT)"
