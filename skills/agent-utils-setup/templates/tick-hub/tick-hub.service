[Unit]
Description={{PROJECT}} harness: one tick-hub tick, ACTION lines delivered to the coordinator

[Service]
Type=oneshot
# A user service does not inherit an interactive PATH; agentctl needs herdr, the harness, and
# cargo (the paired tools' default Rust launcher checks its Cargo cache on every run).
Environment=PATH={{PATH}}
WorkingDirectory={{HARNESS}}
ExecStart={{HARNESS}}/bin/tick-deliver coordinator
