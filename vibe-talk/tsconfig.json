{
  // TypeScript as a checker only: `tsc` reads the page's JavaScript in web/ (checkJs) against the
  // generated contract declarations. The page ships web/build.mjs's minified bundle of it. Run it with
  // `make -C vibe-talk typecheck`. `strict` is off for now; see the transient design record for
  // the measured strict-mode backlog and the order it is meant to be paid down in.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": false,
    // web/legacy-imports.d.ts types what the page build's prelude declares for voice.js by importing
    // the modules' own types (`#624 voice-page-modularity`).
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "files": ["web/contract.d.ts", "web/globals.d.ts", "web/legacy-imports.d.ts", "web/voice.js"]
}
