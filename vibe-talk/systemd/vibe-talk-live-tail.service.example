[Unit]
Description=Slack event-stream records, text included, for every vibe-talk Slack channel
Documentation=https://github.com/rrnewton/agent-utils/tree/main/vibe-talk#stream-records
Wants=network-online.target
After=network-online.target vibe-talk.service
Requires=vibe-talk.service
PartOf=vibe-talk.service

[Service]
Type=exec
# Replace all REPLACE_* values and both absolute executable paths. The command after `--` is the
# event source: here a vendor CLI's conversation tail, with illustrative flags (use your CLI's
# own). The adapter fills {channels} with every conversation vibe-talk names at
# GET /api/v1/live/tail (comma-separated), and {catchup} with the stream position saved in
# --state-file, or with --initial-catchup when none is saved. Heartbeats are dropped by the
# adapter itself. Every argument is invoked literally; no shell is involved.
ExecStart=/usr/bin/python3 /REPLACE_WITH_CHECKOUT/vibe-talk/scripts/live-hint-adapter.py --records --url http://127.0.0.1:8080 --token-file %h/.config/vibe-talk/ingest-token --state-file %S/vibe-talk/live-tail.json -- /REPLACE_WITH_VENDOR_CLI conversation tail --channel-id={channels} --catchup={catchup} --event-types=message.created,reaction.created,reaction.deleted --include-iris-seq-id --heartbeats --quiet --output=json
StateDirectory=vibe-talk
Restart=on-failure
RestartSec=5
KillMode=control-group
# Longer than one bounded HTTP attempt plus child-group cleanup, so systemd does not SIGKILL at
# the adapter's own graceful-stop boundary.
TimeoutStopSec=30

UMask=0077
# Budgets for a vendor CLI that runs inside a managed runtime, as in
# vibe-talk-live-hint.service.example; re-evaluate them for a different event source.
LimitCORE=0
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=0
TasksMax=2048

[Install]
WantedBy=default.target
